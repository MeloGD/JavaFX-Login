<?xml version="1.0" encoding="UTF-8"?>

<!--
  The window an admitted Operator works in.

  The host product's view goes in the middle, untouched and unknown to this system. Above it sits
  the one control the gate puts on the window: somewhere to log out, so that no host product has to
  write that and none can forget to.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.javafxlogin.ui.login.SessionController">

  <top>
    <HBox styleClass="session-bar" alignment="CENTER_RIGHT" spacing="8.0">
      <padding>
        <Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/>
      </padding>
      <!--
        Empty on an ordinary login. It carries the one thing the AuthenticationService keeps saying
        until somebody reads it — that an Administrator reset this Account's password, and when —
        because the login screen it was said on has already closed by the time this window opens.

        The button beside it is what ends it. The service repeats the notice at every admission
        until it arrives, so a person who never dismisses it is told again tomorrow; both controls
        are unmanaged while there is nothing to say, so an empty notice takes no room.
      -->
      <Label fx:id="notice" styleClass="warning" wrapText="true" maxWidth="Infinity"
             HBox.hgrow="ALWAYS"/>
      <Button fx:id="noticeRead" text="Entendido" onAction="#onNoticeRead"
              visible="false" managed="false"/>
      <Button fx:id="logOut" text="Cerrar sesión" onAction="#onLogOut"/>
    </HBox>
  </top>

  <center>
    <StackPane fx:id="protectedFeature"/>
  </center>
</BorderPane>
