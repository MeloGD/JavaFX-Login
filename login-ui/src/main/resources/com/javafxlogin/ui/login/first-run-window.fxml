<?xml version="1.0" encoding="UTF-8"?>

<!--
  The first-run wizard: the only way the single Administrator ever comes into existence.

  Nothing is prefilled and nothing is suggested, not even as a prompt. ADR-0002 keeps the account
  list unreadable, so a predictable name hands an entry of it back for free, and a placeholder
  reading "admin" would be this application suggesting the one name an attacker guesses first.

  The warning about the password sits above the fields rather than beside the button: there is no
  recovery key and there never will be, so it has to be read while there is still a choice to make.

  Every string here is a %key the FXMLLoader resolves out of the bundle for the language this screen
  is drawn in, which is the machine's own: nobody has authenticated yet, so there is no Account
  whose preference could answer instead.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.javafxlogin.ui.login.FirstRunController"
      styleClass="login" spacing="8.0" prefWidth="420.0">

  <padding>
    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
  </padding>

  <Label text="%first-run.title" styleClass="title"/>

  <Label styleClass="explanation" wrapText="true" text="%first-run.explanation"/>

  <Label fx:id="recoveryWarning" styleClass="warning" wrapText="true" text="%first-run.recovery-warning"/>

  <Label text="%first-run.account-name" styleClass="field-label"/>
  <TextField fx:id="administratorName"/>

  <Label text="%first-run.password" styleClass="field-label"/>
  <PasswordField fx:id="administratorPassword"/>

  <Button fx:id="create" text="%first-run.create" onAction="#onCreate"
          defaultButton="true" maxWidth="Infinity"/>

  <Label fx:id="firstRunMessage" styleClass="message" wrapText="true"/>
</VBox>
