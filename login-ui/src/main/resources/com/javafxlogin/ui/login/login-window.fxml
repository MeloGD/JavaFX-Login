<?xml version="1.0" encoding="UTF-8"?>

<!--
  The login window.

  Nothing is prefilled and nothing is suggested, not even as a prompt: ADR-0002 keeps the account
  list unreadable, and a hint at what a name looks like hands part of it back.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.javafxlogin.ui.login.LoginController"
      styleClass="login" spacing="8.0" prefWidth="360.0">

  <padding>
    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
  </padding>

  <Label text="Iniciar sesión" styleClass="title"/>

  <Label text="Nombre de cuenta" styleClass="field-label"/>
  <TextField fx:id="accountName"/>

  <Label text="Contraseña" styleClass="field-label"/>
  <PasswordField fx:id="password"/>

  <Button fx:id="admit" text="Acceder" onAction="#onAdmit" defaultButton="true"
          maxWidth="Infinity"/>

  <Label fx:id="message" styleClass="message" wrapText="true"/>
</VBox>
