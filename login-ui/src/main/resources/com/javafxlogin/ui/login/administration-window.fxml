<?xml version="1.0" encoding="UTF-8"?>

<!--
  The administration panel.

  The Accounts of the deployment at the top, and everything an Administrator does about one of them
  below. There is no field on this screen where an Account's password could be typed, and that is the
  point rather than an omission: an Administrator creates an Account and is handed a one-time secret
  to give away, and never knows a credential somebody goes on using.

  The one password box at the bottom is not that, and the comment beside it says so: it encrypts a
  Backup file, belongs to no Account, and admits nobody.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.javafxlogin.ui.login.AdministrationController"
            styleClass="login" prefWidth="820.0" prefHeight="780.0">

  <top>
    <HBox styleClass="session-bar" alignment="CENTER_RIGHT" spacing="8.0">
      <padding>
        <Insets top="8.0" right="12.0" bottom="8.0" left="12.0"/>
      </padding>
      <Label text="%administration.title" styleClass="title" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
      <Button fx:id="logOut" text="%administration.log-out" onAction="#onLogOut"/>
    </HBox>
  </top>

  <center>
    <VBox spacing="8.0">
      <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
      </padding>

      <Label text="%administration.accounts" styleClass="field-label"/>
      <!--
        Every column is a fact the service sent: the Role, the coarse band, the language the person
        reads and whether the Account is refused for a while. No hash and nothing derived from one:
        the list is built inside the privileged process and has no field one could travel in.
      -->
      <TableView fx:id="accounts" prefHeight="130.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="accountName" text="%administration.column.account" prefWidth="200.0"/>
          <TableColumn fx:id="role" text="%administration.column.role" prefWidth="130.0"/>
          <TableColumn fx:id="passwordStrength" text="%administration.column.password" prefWidth="120.0"/>
          <TableColumn fx:id="languagePreference" text="%administration.column.language" prefWidth="180.0"/>
          <TableColumn fx:id="lockout" text="%administration.column.lockout" prefWidth="150.0"/>
        </columns>
      </TableView>

      <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Button fx:id="resetPassword" text="%administration.reset-password" onAction="#onResetPassword"/>
        <Button fx:id="clearLockout" text="%administration.clear-lockout" onAction="#onClearLockout"/>
        <Button fx:id="deleteOperator" text="%administration.delete-operator" onAction="#onDeleteOperator"/>
      </HBox>

      <!--
        What deleting costs, said before it happens and confirmed separately. Unmanaged until then,
        so that a warning about an Account nobody chose takes no room.
      -->
      <Label fx:id="deleteConsequences" styleClass="warning" wrapText="true" maxWidth="Infinity"
             visible="false" managed="false"/>
      <HBox fx:id="deleteControls" spacing="8.0">
        <Button fx:id="confirmDelete" text="%administration.confirm-delete" onAction="#onConfirmDelete"
                visible="false" managed="false"/>
        <Button fx:id="cancelDelete" text="%administration.cancel-delete" onAction="#onCancelDelete"
                visible="false" managed="false"/>
      </HBox>

      <!--
        Issue #13: which language the person using an Account reads, chosen from the same list the
        login screen offers plus the machine's own. It is one of the things done to a chosen
        Account, and it changes nothing about the panel it is set from — an Administrator setting
        somebody else's language is not changing their own screens, and setting their own takes
        effect at their next admission, which is when the service is asked whose preference to
        apply.
      -->
      <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="%administration.language"/>
        <ComboBox fx:id="languageChoice" prefWidth="200.0"
                  accessibleText="%administration.language"/>
        <Button fx:id="applyLanguage" text="%administration.apply-language"
                onAction="#onApplyLanguage"/>
      </HBox>

      <Separator/>

      <Label text="%administration.create-operator" styleClass="field-label"/>
      <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="newOperatorName" promptText="%administration.new-operator-name" prefWidth="240.0"/>
        <Button fx:id="createOperator" text="%administration.create-and-issue" onAction="#onCreateOperator"/>
      </HBox>

      <!--
        The one thing the AuthenticationService will never say again. It is shown once, with the
        warning beside it, and there is no request anywhere on the LoginGate that reads it back.
      -->
      <Label fx:id="enrolmentSecret" styleClass="secret" visible="false" managed="false"/>
      <Label fx:id="enrolmentSecretWarning" styleClass="warning" wrapText="true"
             maxWidth="Infinity" visible="false" managed="false"/>
      <Button fx:id="enrolmentSecretRead" text="%administration.enrolment-secret-read" onAction="#onEnrolmentSecretRead"
              visible="false" managed="false"/>

      <Separator/>

      <Label text="%administration.configuration" styleClass="field-label"/>
      <HBox spacing="8.0" alignment="CENTER_LEFT">
        <Label text="%administration.inactivity-minutes"/>
        <TextField fx:id="inactivityMinutes" prefWidth="80.0"/>
        <CheckBox fx:id="neverExpires" text="%administration.never-expires"/>
        <Button fx:id="applyInactivityPeriod" text="%administration.apply" onAction="#onApplyInactivityPeriod"/>
      </HBox>

      <!--
        Reserved by CONTEXT.md and by the CredentialStore's own column: nothing implements a
        SecondFactor in this version, and the control is visibly disabled rather than absent so that
        the seam has somewhere to surface later.
      -->
      <CheckBox fx:id="secondFactor" text="%administration.second-factor"
                disable="true"/>

      <Separator/>

      <Label text="%administration.events" styleClass="field-label"/>
      <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="exportDestination" promptText="%administration.export-destination"
                   prefWidth="360.0"/>
        <Button fx:id="export" text="%administration.export" onAction="#onExport"/>
      </HBox>
      <Label text="%administration.export-explanation"
             styleClass="explanation" wrapText="true"/>

      <Separator/>

      <!--
        Issue #14. The one password box on this screen, and it is not an exception to the rule above
        it: what goes in here encrypts a file, belongs to no Account, and admits nobody. ADR-0006 is
        why it has to exist — a backup bound to the machine that wrote it is useless on the day that
        machine dies, so a password and Argon2id are what is left protecting one that is not.
      -->
      <Label text="%administration.backup" styleClass="field-label"/>
      <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="backupFile" promptText="%administration.backup-file" prefWidth="300.0"/>
        <PasswordField fx:id="backupPassword" promptText="%administration.backup-password"
                       prefWidth="180.0"/>
        <Button fx:id="exportBackup" text="%administration.export-backup"
                onAction="#onExportBackup"/>
        <Button fx:id="importBackup" text="%administration.import-backup"
                onAction="#onImportBackup"/>
      </HBox>

      <!--
        What restoring costs, said before it happens and confirmed separately — the same shape the
        delete has, because it is the same kind of thing done to every Account at once. Unmanaged
        until then, so that a warning nobody is being shown takes no room. It sits above the
        explanation rather than below it so that the two buttons stay next to the controls they are
        about, however many lines the wording runs to in whichever language.
      -->
      <Label fx:id="importConsequences" styleClass="warning" wrapText="true" maxWidth="Infinity"
             visible="false" managed="false"/>
      <HBox spacing="8.0">
        <Button fx:id="confirmImport" text="%administration.confirm-import"
                onAction="#onConfirmImport" visible="false" managed="false"/>
        <Button fx:id="cancelImport" text="%administration.cancel-import"
                onAction="#onCancelImport" visible="false" managed="false"/>
      </HBox>

      <Label text="%administration.backup-explanation"
             styleClass="explanation" wrapText="true"/>

      <Label fx:id="message" styleClass="message" wrapText="true" maxWidth="Infinity"/>
    </VBox>
  </center>
</BorderPane>
