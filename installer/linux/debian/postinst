#!/bin/sh
# postinst script for javafx-login
#
# Runs as root, on a first installation and on every upgrade, after the payload is in
# place. Three things happen here and they are in this order on purpose: the machine is
# wired, then the files are brought forward, then the person who installed the product is
# admitted to the group that may reach the socket.
#
# It is deliberately thin. Everything it does to systemd is install.sh, which ships in the
# payload and is the same script a developer runs by hand — a package that reimplemented
# that wiring would be a second place for it to be wrong, and only one of the two would
# ever be run by the person debugging it.

set -e

PAYLOAD=/opt/javafx-login
STORE=/var/lib/javafx-login/credentials.db

# Whoever ran the installation, as the operating system names them. Reaching the socket is
# a group membership and nothing else — it admits nobody to anything without a password,
# because the AuthenticationService still asks for one — but without it the person who has
# just installed the product cannot connect to it at all, and the product would ship with a
# manual step nobody is told about. sudo and pkexec each say who they are acting for.
#
# An account that no longer exists is treated as nobody rather than passed on: install.sh
# refuses a name it cannot find, and it is right to — a typo there is a mistake somebody
# made — but that refusal arriving here would fail an installation whose group, directory
# and units were already correct, over the least important thing this script does.
installing_account() {
    account=''
    if [ -n "${SUDO_USER:-}" ]; then
        account="${SUDO_USER}"
    elif [ -n "${PKEXEC_UID:-}" ]; then
        account="$(getent passwd "${PKEXEC_UID}" | cut -d: -f1)"
    fi
    if [ -n "${account}" ] && id "${account}" >/dev/null 2>&1; then
        echo "${account}"
    fi
}

# Said where nobody was admitted, because the alternative is a person who installed this
# product, opened it, and was told the AuthenticationService is not running.
report_that_nobody_was_admitted() {
    echo "javafx-login: nobody was added to the javafx-login group — this installation did" >&2
    echo "  not say who it was for. Whoever is to use the product needs:" >&2
    echo "    sudo ${PAYLOAD}/lib/systemd/install.sh <account>" >&2
    echo "  and must then log out and back in." >&2
}

case "$1" in
    configure)
DESKTOP_COMMANDS_INSTALL

        # The files first, and nothing is listening yet while this runs. Migrations happen
        # here rather than at the next activation, while somebody is watching: under socket
        # activation nobody is watching afterwards, and a service that cannot open its
        # files looks exactly like one that has not been connected to yet — so a failed
        # migration would reach its owner as "the AuthenticationService is not running",
        # long after this installation said that it succeeded.
        #
        # A store written by a later build than this one stops the installation here, with
        # both versions named. That refusal is the reason for the order: the socket has not
        # been enabled yet, so a machine whose upgrade was refused is one nothing can be
        # activated on, rather than one where the next login finds a service that dies.
        # There is nothing to migrate on a first installation, and it says so.
        "${PAYLOAD}/bin/javafx-login-authd" "${STORE}" --upgrade

        # Then the machine. The group, the state directory and its 0700 are asserted again
        # on every upgrade rather than assumed to have survived one: an upgrade that quietly
        # loosened the mode on the directory holding the CredentialStore, the SecretVault
        # and the AuthenticationEvents would undo the only real security property this
        # product has, and it would do it silently — everything would go on working.
        admitted="$(installing_account)"
        "${PAYLOAD}/lib/systemd/install.sh" ${admitted}
        [ -n "${admitted}" ] || report_that_nobody_was_admitted
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
