# The privileged AuthenticationService: it owns the CredentialStore, the SecretVault, the
# Lockout records and the AuthenticationEvents, and it is the only party that can verify a
# password.
#
# There is deliberately no [Install] section. This unit is never enabled: it is started by
# a client connecting to javafx-login-authd.socket, and it stops by itself five minutes
# after the last client has gone. An enabled copy of this would be a privileged JVM
# running on a machine nobody has logged in to.

[Unit]
Description=JavaFX Login AuthenticationService
Documentation=file:/opt/javafx-login/lib/doc/linux-service-activation.md
Requires=javafx-login-authd.socket

[Service]
Type=simple

# Load-bearing. It is what connects the listening socket to file descriptor 0, where
# System.inheritedChannel() looks for it; systemd's own $LISTEN_FDS is deliberately not
# set in this mode, and nothing in this product reads it. Without this line the service
# inherits nothing and refuses to start.
StandardInput=socket

# Set explicitly, and never left at the default. The default inherits the socket, and
# anything the JVM prints — a stack trace, a JVM warning — would then be written straight
# into whatever client happens to be connected.
StandardOutput=journal
StandardError=journal

# The launcher jpackage builds, rather than a java command written out here. It loads the
# runtime shipped with the product — never whatever JDK the machine happens to have — in
# this process rather than a child of it, which is what keeps the inherited socket on file
# descriptor 0 where System.inheritedChannel() looks for it. There is no --add-opens and no
# --add-exports: the service names only java.lang.System and java.nio.channels to obtain
# its channel.
#
# The store's path is written out rather than baked into the launcher, because the upgrade
# the package runs at install time names the same file and the two must be read together.
ExecStart=/opt/javafx-login/bin/javafx-login-authd /var/lib/javafx-login/credentials.db

# Nothing is set about restarting, deliberately: exiting when nobody is using it is this
# service's normal ending and the defaults already read it that way. The socket unit stays
# listening either way, so the next connection is what starts it again.
